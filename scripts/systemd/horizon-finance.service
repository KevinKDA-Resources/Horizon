[Unit]
Description=Horizon personal finance + AI daily digest
Documentation=https://github.com/KevinKDA-Resources/Horizon
# Only run when the machine has working network.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Abort quickly if the script exceeds 60 minutes (normal run is 5-35 min
# depending on watchlist size and LLM response times).
TimeoutStartSec=3600
# Run horizon; script sets its own PATH and loads .env internally.
# %h is the user's home directory. Edit this path if your clone is elsewhere.
WorkingDirectory=%h/code/Horizon
ExecStart=%h/code/Horizon/scripts/daily-finance.sh
# Hardening: the script only reads/writes under the project directory.
ProtectSystem=strict
ReadWritePaths=%h/code/Horizon
NoNewPrivileges=true
PrivateTmp=true
# Stream stdout/stderr to the journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=horizon-finance

[Install]
WantedBy=default.target
