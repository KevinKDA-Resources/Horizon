# Copy this file to .env and fill in real credentials.
# The real .env is .gitignore'd and MUST NEVER be committed.
#
# Required: one LLM provider. This config uses the AWS API Gateway
# OpenAI-compatible proxy so only OPENAI_API_KEY is actually needed.

# Endpoint URL for the custom OpenAI-compatible proxy.
# Referenced as ${HORIZON_AI_BASE_URL} in data/config.json so the URL
# itself never lands in git. Ask the project owner for the real value.
HORIZON_AI_BASE_URL=https://YOUR-PROXY-HOST.example.com/api/v1
OPENAI_API_KEY=bag-proxy-key-xxxxxxxxxxxx

# Optional: GitHub token lifts the anonymous rate limit
# from 60 req/h to 5000 req/h.
# GITHUB_TOKEN=ghp_xxx

# Optional: Apify token, only required if sources.twitter.enabled=true.
# APIFY_TOKEN=apify_api_xxx

# Optional: webhook URL for daily-digest delivery to Feishu / Slack / ...
# HORIZON_WEBHOOK_URL=https://...

# ----------------------------------------------------------------------
# OpenBB Platform provider keys (all optional - free providers work
# without any of them). The OpenBB SDK reads these from the environment
# directly, Horizon does not pass them through.
#
# Free tiers you can sign up for in minutes:
#   FMP:      https://site.financialmodelingprep.com/developer/docs
#   Polygon:  https://polygon.io/
#   Tiingo:   https://www.tiingo.com/
#   FRED:     https://fred.stlouisfed.org/docs/api/api_key.html
# Paid:
#   Benzinga:  news-only provider, needs a subscription
#   Intrinio:  comprehensive fundamentals
# ----------------------------------------------------------------------
# OPENBB_FMP_API_KEY=
# OPENBB_POLYGON_API_KEY=
# OPENBB_TIINGO_TOKEN=
# OPENBB_FRED_API_KEY=
# OPENBB_BENZINGA_API_KEY=
# OPENBB_INTRINIO_API_KEY=
